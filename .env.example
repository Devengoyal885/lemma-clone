# Lemma Configuration Example
# Copy this file to .env and adjust values for your setup

# API Configuration
LEMMA_API_V1_STR=/api/v1
LEMMA_PROJECT_NAME="Lemma Plagiarism Analysis Platform"

# Mode and Features
# LEMMA_MODE options: "lite" (default, no external deps) or "auto" (tries advanced)
# Lite Mode uses TF-IDF + local references, works without PostgreSQL/Elasticsearch
LEMMA_MODE=lite
LEMMA_CELERY_ALWAYS_EAGER=true

# File Upload Settings
LEMMA_MAX_FILE_SIZE_MB=100
LEMMA_ALLOWED_EXTENSIONS=pdf,docx,txt

# NLP Models
LEMMA_SPACY_MODEL=en_core_web_sm
LEMMA_SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

# Plagiarism Detection Thresholds (0.0 to 1.0)
LEMMA_LEXICAL_THRESHOLD=0.70
LEMMA_SEMANTIC_THRESHOLD=0.65
LEMMA_HYBRID_THRESHOLD=0.60

# Optional: PostgreSQL (for Advanced Mode)
# Leave empty for Lite Mode
LEMMA_DATABASE_URL=
LEMMA_POSTGRES_HOST=localhost
LEMMA_POSTGRES_PORT=5432
LEMMA_POSTGRES_DB=lemma
LEMMA_POSTGRES_USER=postgres
LEMMA_POSTGRES_PASSWORD=postgres

# Optional: Elasticsearch (for Advanced Mode)
LEMMA_ELASTICSEARCH_URL=http://localhost:9200

# Optional: Redis & Celery (for async tasks)
LEMMA_REDIS_URL=redis://localhost:6379/0

# Optional: Online Retrieval (Semantic Scholar API)
LEMMA_ENABLE_ONLINE_RETRIEVAL=false
LEMMA_SEMANTIC_SCHOLAR_API_KEY=

# Ollama Local LLM Configuration
LEMMA_OLLAMA_URL=http://127.0.0.1:11434
LEMMA_OLLAMA_MODEL=lemma-model

# References Database
LEMMA_MOCK_DATABASE_PATH=backend/app/data/mock_references.json
